#: src/QuoteButton.php
msgid "Add to quote"
msgstr "Προσθήκη στην προσφορά"

#: woo-quote-request.php
msgid "Woo Quote Request needs its Composer files. Run composer install in the plugin folder."
msgstr "Το Woo Quote Request χρειάζεται τα αρχεία του Composer. Εκτελέστε composer install στον φάκελο του πρόσθετου."

#: woo-quote-request.php
msgid "Woo Quote Request needs WooCommerce. Activate WooCommerce, or deactivate this plugin."
msgstr "Το Woo Quote Request χρειάζεται το WooCommerce. Ενεργοποιήστε το WooCommerce ή απενεργοποιήστε αυτό το πρόσθετο."

msgid "Enter your name."
msgstr "Συμπληρώστε το όνομά σας."

#. translators: %d: product ID.
#, php-format
msgid "Product %d cannot be quoted."
msgstr "Το προϊόν %d δεν είναι διαθέσιμο για προσφορά."

msgid "The quote could not be saved."
msgstr "Δεν ήταν δυνατή η αποθήκευση του αιτήματος προσφοράς."

msgid "The request could not be accepted."
msgstr "Δεν ήταν δυνατή η αποδοχή του αιτήματος."

msgid "Quote not found."
msgstr "Το αίτημα προσφοράς δεν βρέθηκε."

msgid "The quote could not be updated."
msgstr "Δεν ήταν δυνατή η ενημέρωση του αιτήματος προσφοράς."

msgid "Too many quote requests. Try again later."
msgstr "Πάρα πολλά αιτήματα προσφοράς. Δοκιμάστε ξανά αργότερα."

#. translators: 1: site name, 2: quote ID.
#, php-format
msgid "[%1$s] New quote request #%2$d"
msgstr "[%1$s] Νέο αίτημα προσφοράς #%2$d"

#. translators: %s: customer's name.
#, php-format
msgid "Name: %s"
msgstr "Όνομα: %s"

#. translators: %s: customer's email address.
#, php-format
msgid "Email: %s"
msgstr "Email: %s"

#. translators: %s: customer's phone number.
#, php-format
msgid "Phone: %s"
msgstr "Τηλέφωνο: %s"

msgid "Message:"
msgstr "Μήνυμα:"

msgid "Products:"
msgstr "Προϊόντα:"

#. translators: %s: site name.
#, php-format
msgid "[%s] We received your quote request"
msgstr "[%s] Λάβαμε το αίτημα προσφοράς σας"

#. translators: %d: quote ID.
#, php-format
msgid "Thank you. We received your quote request #%d for these products:"
msgstr "Σας ευχαριστούμε. Λάβαμε το αίτημα προσφοράς #%d για τα παρακάτω προϊόντα:"

msgid "We will reply to this email address."
msgstr "Θα σας απαντήσουμε σε αυτή τη διεύθυνση email."
